# Network RPC URLs
RPC_TEST=http://127.0.0.1:1234/rpc/v1
RPC_CALIBNET=https://api.calibration.node.glif.io/rpc/v1
RPC_MAINNET=https://api.node.glif.io/rpc/v1

# Deployment keys (one per network)
PRIVATE_KEY_TEST=<your_private_key>
PRIVATE_KEY_CALIBNET=<your_private_key>
PRIVATE_KEY_MAINNET=<your_private_key>

# Calibnet external addresses (required by script/Deploy.s.sol mapped in justfile)
FILECOIN_PAY_CALIBNET=<filecoin_pay_calibnet>
TERMINATION_ORACLE_CALIBNET=<termination_oracle_calibnet>
ORACLE_CALIBNET=<oracle_calibnet>
POREP_SERVICE_CALIBNET=<porep_service_calibnet>
META_ALLOCATOR_CALIBNET=<metaallocator_calibnet>
OPERATOR_ADDR_CALIBNET=<operator_automation_calibnet>   # optional

# Mainnet external addresses (required by script/Deploy.s.sol mapped in justfile)
FILECOIN_PAY_MAINNET=<filecoin_pay_mainnet>
TERMINATION_ORACLE_MAINNET=<termination_oracle_mainnet>
ORACLE_MAINNET=<oracle_mainnet>
POREP_SERVICE_MAINNET=<porep_service_mainnet>
META_ALLOCATOR_MAINNET=<metaallocator_mainnet>
OPERATOR_ADDR_MAINNET=<operator_automation_mainnet>    # optional

# Upgrade script (script/Upgrade.s.sol)
UPGRADE_CONTRACT_NAME=Client
UPGRADE_CALLDATA=0x

# Mainnet production-deploy gates (see docs/howto/2026-04-15-mainnet-deploy.md)
# CONFIRM_MAINNET=yes       # required for any mainnet deploy/upgrade/verify
# ALLOW_DIRTY_TREE=yes      # override clean-tree gate (discouraged)
# ALLOW_REDEPLOY=yes        # override manifest-exists gate on mainnet_deploy