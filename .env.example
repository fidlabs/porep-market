# Network RPC URLs
RPC_CALIBNET=https://api.calibration.node.glif.io/rpc/v1
RPC_MAINNET=https://api.node.glif.io/rpc/v1

# Deployment and upgrade keys
PRIVATE_KEY_CALIBNET=<your_calibnet_private_key>
PRIVATE_KEY_MAINNET=<your_mainnet_private_key>
RESCUE_PRIVATE_KEY_MAINNET=<your_rescue_private_key>

# Calibnet dependencies
FILECOIN_PAY_CALIBNET=<filecoin_pay_calibnet>
TERMINATION_ORACLE_CALIBNET=<termination_oracle_calibnet>
ORACLE_CALIBNET=<oracle_calibnet>
POREP_SERVICE_CALIBNET=<porep_service_calibnet>
META_ALLOCATOR_CALIBNET=<meta_allocator_calibnet>
OPERATOR_ADDR_CALIBNET=<operator_calibnet>

# Mainnet dependencies
FILECOIN_PAY_MAINNET=<filecoin_pay_mainnet>
TERMINATION_ORACLE_MAINNET=<termination_oracle_mainnet>
ORACLE_MAINNET=<oracle_mainnet>
POREP_SERVICE_MAINNET=<porep_service_mainnet>
META_ALLOCATOR_MAINNET=<meta_allocator_mainnet>
OPERATOR_ADDR_MAINNET=<operator_mainnet>

# Set OPERATOR_ADDR_* to the zero address to skip the OPERATOR_ROLE grant.
# Mainnet deploy, upgrade, and finalization commands require CONFIRM_MAINNET=yes.
